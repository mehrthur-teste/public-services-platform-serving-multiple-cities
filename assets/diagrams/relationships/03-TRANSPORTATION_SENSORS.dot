digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.35", splines=spline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=12, labelfontsize=12, labeldistance=2.2, penwidth=1.3];
"cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>cities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR></TABLE>>];
"roads" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>roads [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="road_id" ALIGN="LEFT">road_id</TD></TR></TABLE>>];
"facilities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>facilities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR></TABLE>>];
"media_assets" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>media_assets [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"monitoring_units" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>monitoring_units</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="unit_id" ALIGN="LEFT">unit_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="road_id" ALIGN="LEFT">road_id</TD></TR></TABLE>>];
"sensors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>sensors</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="sensor_id" ALIGN="LEFT">sensor_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="unit_id" ALIGN="LEFT">unit_id</TD></TR></TABLE>>];
"traffic_readings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>traffic_readings</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="reading_id" ALIGN="LEFT">reading_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="sensor_id" ALIGN="LEFT">sensor_id</TD></TR></TABLE>>];
"transit_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>transit_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="transit_event_id" ALIGN="LEFT">transit_event_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="stop_id" ALIGN="LEFT">stop_id</TD></TR></TABLE>>];
"capture_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>capture_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="capture_id" ALIGN="LEFT">capture_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="reading_id" ALIGN="LEFT">reading_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="camera_id" ALIGN="LEFT">camera_id</TD></TR></TABLE>>];
"capture_media" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>capture_media</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / FK</FONT></TD><TD PORT="capture_id" ALIGN="LEFT">capture_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / REF</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"cities" -> "monitoring_units" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"roads" -> "monitoring_units" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"monitoring_units" -> "sensors" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"sensors" -> "traffic_readings" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"facilities" -> "transit_events" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"traffic_readings" -> "capture_events" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"sensors" -> "capture_events" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"capture_events" -> "capture_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"media_assets" -> "capture_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
}