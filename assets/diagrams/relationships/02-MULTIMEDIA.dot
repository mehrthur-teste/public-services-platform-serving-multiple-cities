digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.35", splines=spline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=12, labelfontsize=12, labeldistance=2.2, penwidth=1.3];
"media_assets" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>media_assets</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"capture_media" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>capture_media [external]</B></FONT><BR/><FONT POINT-SIZE="11">TRANSPORTATION_SENSORS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / FK</FONT></TD><TD PORT="capture_id" ALIGN="LEFT">capture_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / REF</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"request_media" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>request_media [external]</B></FONT><BR/><FONT POINT-SIZE="11">CITIZEN_SERVICE_REQUESTS</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / FK</FONT></TD><TD PORT="request_id" ALIGN="LEFT">request_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / REF</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"inspection_media" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>inspection_media [external]</B></FONT><BR/><FONT POINT-SIZE="11">FACILITY_MAINTENANCE</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / FK</FONT></TD><TD PORT="inspection_id" ALIGN="LEFT">inspection_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / REF</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"media_assets" -> "capture_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"media_assets" -> "request_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"media_assets" -> "inspection_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
}