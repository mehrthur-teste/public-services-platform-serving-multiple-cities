digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.35", splines=spline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=12, labelfontsize=12, labeldistance=2.2, penwidth=1.3];
"cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>cities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR></TABLE>>];
"roads" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>roads [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="road_id" ALIGN="LEFT">road_id</TD></TR></TABLE>>];
"facilities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>facilities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR></TABLE>>];
"media_assets" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>media_assets [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>departments</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="parent_department_id" ALIGN="LEFT">parent_department_id</TD></TR></TABLE>>];
"service_requests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>service_requests</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="request_id" ALIGN="LEFT">request_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="road_id" ALIGN="LEFT">road_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD></TR></TABLE>>];
"request_status_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>request_status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="history_id" ALIGN="LEFT">history_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="request_id" ALIGN="LEFT">request_id</TD></TR></TABLE>>];
"request_media" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>request_media</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / FK</FONT></TD><TD PORT="request_id" ALIGN="LEFT">request_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / REF</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"cities" -> "departments" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"departments" -> "departments" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#294E6C", style="solid"];
"cities" -> "service_requests" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"roads" -> "service_requests" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"facilities" -> "service_requests" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"departments" -> "service_requests" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#294E6C", style="solid"];
"service_requests" -> "request_status_history" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"service_requests" -> "request_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"media_assets" -> "request_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
}