digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.35", splines=spline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=12, labelfontsize=12, labeldistance=2.2, penwidth=1.3];
"cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>cities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR></TABLE>>];
"service_zones" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>service_zones [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="zone_id" ALIGN="LEFT">zone_id</TD></TR></TABLE>>];
"response_rules" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>response_rules</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="rule_id" ALIGN="LEFT">rule_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="zone_id" ALIGN="LEFT">zone_id</TD></TR></TABLE>>];
"rule_versions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>rule_versions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="rule_version_id" ALIGN="LEFT">rule_version_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="rule_id" ALIGN="LEFT">rule_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF*</FONT></TD><TD PORT="target_department_ref" ALIGN="LEFT">target_department_ref</TD></TR></TABLE>>];
"alerts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>alerts</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="alert_id" ALIGN="LEFT">alert_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="rule_version_id" ALIGN="LEFT">rule_version_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF*</FONT></TD><TD PORT="source_context___source_event_id" ALIGN="LEFT">source_context + source_event_id</TD></TR></TABLE>>];
"alert_actions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>alert_actions</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="action_id" ALIGN="LEFT">action_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="alert_id" ALIGN="LEFT">alert_id</TD></TR></TABLE>>];
"escalation_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>escalation_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="escalation_id" ALIGN="LEFT">escalation_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="alert_id" ALIGN="LEFT">alert_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF*</FONT></TD><TD PORT="from_department_ref" ALIGN="LEFT">from_department_ref</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF*</FONT></TD><TD PORT="to_department_ref" ALIGN="LEFT">to_department_ref</TD></TR></TABLE>>];
"cities" -> "response_rules" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"service_zones" -> "response_rules" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"response_rules" -> "rule_versions" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"rule_versions" -> "alerts" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"alerts" -> "alert_actions" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"alerts" -> "escalation_history" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
}