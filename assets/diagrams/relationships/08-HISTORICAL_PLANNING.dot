digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.35", splines=spline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=12, labelfontsize=12, labeldistance=2.2, penwidth=1.3];
"cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>cities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR></TABLE>>];
"roads" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>roads [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="road_id" ALIGN="LEFT">road_id</TD></TR></TABLE>>];
"facilities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>facilities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR></TABLE>>];
"dim_date" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>dim_date</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="date_key" ALIGN="LEFT">date_key</TD></TR></TABLE>>];
"dim_city" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>dim_city</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="city_key" ALIGN="LEFT">city_key</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="source_city_id" ALIGN="LEFT">source_city_id</TD></TR></TABLE>>];
"dim_facility" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>dim_facility</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="facility_key" ALIGN="LEFT">facility_key</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="source_facility_id" ALIGN="LEFT">source_facility_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="city_key" ALIGN="LEFT">city_key</TD></TR></TABLE>>];
"fact_traffic_summary" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>fact_traffic_summary</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="traffic_summary_id" ALIGN="LEFT">traffic_summary_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="date_key" ALIGN="LEFT">date_key</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="city_key" ALIGN="LEFT">city_key</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="source_road_id" ALIGN="LEFT">source_road_id</TD></TR></TABLE>>];
"fact_environmental_summary" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>fact_environmental_summary</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="environmental_summary_id" ALIGN="LEFT">environmental_summary_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="date_key" ALIGN="LEFT">date_key</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="city_key" ALIGN="LEFT">city_key</TD></TR></TABLE>>];
"fact_service_performance" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>fact_service_performance</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="service_summary_id" ALIGN="LEFT">service_summary_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="date_key" ALIGN="LEFT">date_key</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="city_key" ALIGN="LEFT">city_key</TD></TR></TABLE>>];
"fact_maintenance_cost" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>fact_maintenance_cost</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="maintenance_summary_id" ALIGN="LEFT">maintenance_summary_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="date_key" ALIGN="LEFT">date_key</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="facility_key" ALIGN="LEFT">facility_key</TD></TR></TABLE>>];
"cities" -> "dim_city" [arrowhead=normal, arrowsize=0.55, label="1 : 0..1", color="#77818B", style="dashed"];
"facilities" -> "dim_facility" [arrowhead=normal, arrowsize=0.55, label="1 : 0..1", color="#77818B", style="dashed"];
"dim_city" -> "dim_facility" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"dim_date" -> "fact_traffic_summary" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"dim_city" -> "fact_traffic_summary" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"dim_date" -> "fact_environmental_summary" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"dim_city" -> "fact_environmental_summary" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"dim_date" -> "fact_service_performance" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"dim_city" -> "fact_service_performance" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"dim_date" -> "fact_maintenance_cost" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"dim_facility" -> "fact_maintenance_cost" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"roads" -> "fact_traffic_summary" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
}