digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.35", splines=spline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=12, labelfontsize=12, labeldistance=2.2, penwidth=1.3];
"cities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>cities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR></TABLE>>];
"facilities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>facilities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR></TABLE>>];
"monitoring_devices" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>monitoring_devices</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">ID</FONT></TD><TD PORT="_id" ALIGN="LEFT">_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR></TABLE>>];
"environmental_readings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>environmental_readings</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">ID*</FONT></TD><TD PORT="reading_id" ALIGN="LEFT">reading_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="metadata_device_id" ALIGN="LEFT">metadata.device_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="metadata_city_id" ALIGN="LEFT">metadata.city_id</TD></TR></TABLE>>];
"environmental_events" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>environmental_events</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">ID</FONT></TD><TD PORT="_id" ALIGN="LEFT">_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="device_id" ALIGN="LEFT">device_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="reading_id" ALIGN="LEFT">reading_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="city_id" ALIGN="LEFT">city_id</TD></TR></TABLE>>];
"cities" -> "monitoring_devices" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"facilities" -> "monitoring_devices" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"monitoring_devices" -> "environmental_readings" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"cities" -> "environmental_readings" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"monitoring_devices" -> "environmental_events" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"environmental_readings" -> "environmental_events" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"cities" -> "environmental_events" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
}