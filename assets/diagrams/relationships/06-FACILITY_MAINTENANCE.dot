digraph ERD {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.35", splines=spline, outputorder=edgesfirst];
node [shape=plain, fontname="Arial", fontsize=14];
edge [fontname="Arial", fontsize=12, labelfontsize=12, labeldistance=2.2, penwidth=1.3];
"facilities" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>facilities [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR></TABLE>>];
"media_assets" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>media_assets [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"departments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>departments [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD></TR></TABLE>>];
"service_requests" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#E8EEF4"><FONT COLOR="#173D5D"><B>service_requests [external]</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="request_id" ALIGN="LEFT">request_id</TD></TR></TABLE>>];
"teams" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>teams</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="team_id" ALIGN="LEFT">team_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="department_id" ALIGN="LEFT">department_id</TD></TR></TABLE>>];
"inspections" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>inspections</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="inspection_id" ALIGN="LEFT">inspection_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR></TABLE>>];
"work_orders" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>work_orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="work_order_id" ALIGN="LEFT">work_order_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="facility_id" ALIGN="LEFT">facility_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">REF</FONT></TD><TD PORT="source_request_id" ALIGN="LEFT">source_request_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="source_inspection_id" ALIGN="LEFT">source_inspection_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="completion_inspection_id" ALIGN="LEFT">completion_inspection_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="team_id" ALIGN="LEFT">team_id</TD></TR></TABLE>>];
"work_order_status_history" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>work_order_status_history</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="history_id" ALIGN="LEFT">history_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="work_order_id" ALIGN="LEFT">work_order_id</TD></TR></TABLE>>];
"work_order_costs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>work_order_costs</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="cost_id" ALIGN="LEFT">cost_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="work_order_id" ALIGN="LEFT">work_order_id</TD></TR></TABLE>>];
"equipment_usage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>equipment_usage</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK</FONT></TD><TD PORT="usage_id" ALIGN="LEFT">usage_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">FK</FONT></TD><TD PORT="work_order_id" ALIGN="LEFT">work_order_id</TD></TR></TABLE>>];
"inspection_media" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#6E8599"><TR><TD COLSPAN="2" BGCOLOR="#173D5D"><FONT COLOR="white"><B>inspection_media</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / FK</FONT></TD><TD PORT="inspection_id" ALIGN="LEFT">inspection_id</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#35516A">PK / REF</FONT></TD><TD PORT="media_id" ALIGN="LEFT">media_id</TD></TR></TABLE>>];
"departments" -> "teams" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"facilities" -> "inspections" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"facilities" -> "work_orders" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
"service_requests" -> "work_orders" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#77818B", style="dashed"];
"inspections" -> "work_orders" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N (2 FKs)", color="#294E6C", style="solid"];
"teams" -> "work_orders" [arrowhead=normal, arrowsize=0.55, label="0..1 : 0..N", color="#294E6C", style="solid"];
"work_orders" -> "work_order_status_history" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"work_orders" -> "work_order_costs" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"work_orders" -> "equipment_usage" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"inspections" -> "inspection_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#294E6C", style="solid"];
"media_assets" -> "inspection_media" [arrowhead=normal, arrowsize=0.55, label="1 : 0..N", color="#77818B", style="dashed"];
}